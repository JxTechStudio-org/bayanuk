# Bayanuk production env file: TEMPLATE, no secret values.
#
# The real file lives on the host at /root/secrets/bayanuk.env (owner root, mode 600) and is
# maintained by hand. It is never committed and never printed in Jenkins.
#
# The same file is used twice:
#  1. By Docker Compose for ${...} values in the compose files (ports, DB, RustFS, Redis).
#  2. By the api, horizon and scheduler containers as their environment (Laravel reads it).
#
# Generated secrets must be hex (openssl rand -hex 32). A "$" in a value is read by
# Compose as a variable, so do not use it. Do not quote values unless they contain spaces.
# Leave GEMINI_* and GOOGLE_* empty until those features are live: the app starts without them.

# --- Compose: host ports (localhost only; host nginx connects to them) ---
BAYANUK_WEB_PORT=8090
BAYANUK_FPM_PORT=9110
BAYANUK_RUSTFS_CONSOLE_PORT=9012

# --- Laravel ---
APP_NAME=Bayanuk
APP_ENV=production
# Generated once, before the first deploy. Never regenerate it once data exists:
# sessions, encrypted values and signed URLs depend on it.
APP_KEY=
APP_DEBUG=false
APP_URL=https://bayanuk.jxtechstudio.com
FRONTEND_URL=https://bayanuk.jxtechstudio.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs go to the container output (docker logs, rotated by the json-file driver).
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (DB_HOST and DB_PORT are set by docker-compose.yml) ---
DB_CONNECTION=pgsql
DB_DATABASE=bayanuk
DB_USERNAME=bayanuk
DB_PASSWORD=

# --- Sessions and Sanctum (same origin: frontend and API share the domain) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# null = cookie for this host only (not for other jxtechstudio.com subdomains)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=bayanuk.jxtechstudio.com

# --- Queue, cache, Redis (REDIS_HOST is set by docker-compose.yml) ---
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Mail (Resend). Verify the sending domain in Resend (SPF and DKIM) first. ---
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Bayanuk

# --- File storage (RustFS; AWS_ENDPOINT is set by docker-compose.yml) ---
# These two are also the RustFS root credentials (docker-compose.yml passes them to rustfs).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bayanuk
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Antivirus (CLAMAV_HOST is set by docker-compose.yml) ---
# ClamAV is off until the upload scanning code exists. To turn it on, uncomment the next line
# and redeploy (it needs about 1.2 GB of RAM; see deploy/README.md).
# COMPOSE_PROFILES=clamav
CLAMAV_PORT=3310

# --- AI (empty until Gemini billing is enabled) ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_API_KEY=
BAYANUK_DAILY_AI_BUDGET_USD=

# --- Google sign-in (empty until the callback route exists) ---
# Add this exact redirect URI in Google Cloud Console when the feature goes live.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bayanuk.jxtechstudio.com/api/v1/auth/google/callback
