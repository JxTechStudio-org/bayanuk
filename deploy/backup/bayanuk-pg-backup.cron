# Bayanuk production PostgreSQL backup, daily at 02:30 UTC, 7 days kept.
# Install as /etc/cron.d/bayanuk-pg-backup (root:root 644). See deploy/backup/README.md.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 2 * * * root /usr/local/sbin/bayanuk-pg-backup.sh >> /var/log/bayanuk-pg-backup.log 2>&1
