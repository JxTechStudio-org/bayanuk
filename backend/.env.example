# Application Configuration
APP_NAME=Bayanuk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging & Debugging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Connection (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
FORWARD_DB_PORT=5466
DB_DATABASE=bayanuk
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Session & Authentication (Sanctum & Redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Broadcasting, Queues & Caching (Redis)
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bayanuk.test"
MAIL_FROM_NAME="${APP_NAME}"

# Storage Configuration (RustFS / S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bayanuk
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Google Authentication 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# ClamAV Antivirus Scanner
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# AI Stack (Bayanuk v1.0 - Gemini & Voyage)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

BAYANUK_DAILY_AI_BUDGET_USD=2

# Vite Frontend Variables
VITE_APP_NAME="${APP_NAME}"
